class Solution(object):
    def subarraysDivByK(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: int
        """
        d={0:1}
        cur=0
        c=0
        for i in nums:
            cur+=i
            r=cur%k
            if r in d:
                c+=d[r]
            d[r]=d.get(r,0)+1
        return c
