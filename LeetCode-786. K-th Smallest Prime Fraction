class Solution(object):
    def kthSmallestPrimeFraction(self, arr, k):
        """
        :type arr: List[int]
        :type k: int
        :rtype: List[int]
        """
        r=[]
        for i in range(len(arr)-1):
            for j in range(i+1,len(arr)):
                if arr[i]<arr[j]:
                    f=arr[i]*1.0/arr[j]
                    r.append((f,arr[i],arr[j]))
        r.sort()
        return [r[k-1][1],r[k-1][2]]
