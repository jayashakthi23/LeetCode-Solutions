class Solution(object):
    def removeElement(self, nums, val):
        """
        :type nums: List[int]
        :type val: int
        :rtype: int
        """
        r=[]
        for i in nums:
            if i!=val:
                r.append(i)
        for i in range(len(r)):
            nums[i]=r[i]
        return len(r)
