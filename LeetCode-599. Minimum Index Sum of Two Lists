class Solution(object):
    def findRestaurant(self, list1, list2):
        """
        :type list1: List[str]
        :type list2: List[str]
        :rtype: List[str]
        """
        r=[]
        m=float("inf")
        for i in range(len(list1)):
            for j in range(len(list2)):
                if list1[i]==list2[j]:
                    tot=i+j
                    if tot<m:
                        m=tot
                        r=[list1[i]]
                    elif tot==m:
                        r.append(list1[i])
        return r
