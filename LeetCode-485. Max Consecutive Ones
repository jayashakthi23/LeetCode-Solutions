class Solution(object):
    def findMaxConsecutiveOnes(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        r=[]
        c=0
        for i in nums:
            
            if i==1:
                c+=1
            elif i!=1:
                r.append(c)
                c=0
        r.append(c)
            
        return max(r)
                
