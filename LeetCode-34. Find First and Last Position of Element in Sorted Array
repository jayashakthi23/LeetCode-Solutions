class Solution:
    def searchRange(self, nums: List[int], target: int) -> List[int]:
        r=[]
        for i in range(len(nums)):
            if nums[i]==target:
                r.append(i)
                #nums.pop(i)
        if len(r)==0:
            r.append(-1)
            r.append(-1)
      
        elif len(r)==1:
            a=r[0]
            r.append(a)
        elif len(r)>=3:
            r=[r[0],r[-1]]
            
        return r
