class Solution(object):
    def kidsWithCandies(self, candies, extraCandies):
        """
        :type candies: List[int]
        :type extraCandies: int
        :rtype: List[bool]
        """
        r=[]
        m=max(candies)
        for i in candies:
            if i+extraCandies>=m:
                r.append(True)
            else:
                r.append(False)
        return r
