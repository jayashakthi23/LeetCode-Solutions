class Solution(object):
    def getRow(self, rowIndex):
        """
        :type rowIndex: int
        :rtype: List[int]
        """
        r=[[1]]
        for i in range(rowIndex):
            temp=[0]+r[-1]+[0]
            temp_r=[]
            for i in range(len(temp)-1):
                temp_r.append(temp[i]+temp[i+1])
            r.append(temp_r)
        return r[rowIndex]
