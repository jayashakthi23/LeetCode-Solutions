from collections import Counter
class Solution(object):
    def topKFrequent(self, words, k):
        """
        :type words: List[str]
        :type k: int
        :rtype: List[str]
        """
        d=Counter(words)
        
        l=list(d.keys())
        l.sort(key=lambda x: (-d[x], x))
        return l[:k]
