class Solution(object):
    def threeSumClosest(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: int
        """
        
        nums.sort()
        closet=nums[0]+nums[1]+nums[2]
        for i in range(len(nums)-2):
            l=i+1
            r=len(nums)-1
            while(l<r):
                tot=nums[i]+nums[l]+nums[r]
                if abs(tot-target) < abs(closet-target):
                    closet=tot
                if tot==target:
                    return tot
                elif tot<target:
                    l+=1
                else:
                    r-=1
        return closet
