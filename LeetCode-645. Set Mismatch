class Solution(object):
    def findErrorNums(self, nums):
        """
        :type nums: List[int]
        :rtype: List[int]
        """
        r=[]
        for i in range(len(nums)):
            if nums.count(nums[i])>1:
                r.append(nums[i])
              
                break
        for i in range(1,len(nums)+1):
            if i not in nums:
                r.append(i)
                break
        return r
