class Solution(object):
    def removeDuplicates(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        r=[]
        for i in nums:
            if  i not in r:
                r.append(i)
        for i in range(len(r)):
            nums[i]=r[i]
        return len(r)
