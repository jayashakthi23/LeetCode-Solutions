class Solution(object):
    def uncommonFromSentences(self, s1, s2):
        """
        :type s1: str
        :type s2: str
        :rtype: List[str]
        """
        words=s1.split()+s2.split()
        r=[]
        for i in words:
            if words.count(i)==1:
                r.append(i)
        return r
