class Solution(object):
    def twoSum(self, numbers, target):
        """
        :type numbers: List[int]
        :type target: int
        :rtype: List[int]
        """
        l=0
        h=len(numbers)-1
        while(l<h):
            a=numbers[l]+numbers[h]
            if a==target:
                return l+1,h+1
            elif a>target:
                h=h-1
            elif a<target:
                l=l+1
            
