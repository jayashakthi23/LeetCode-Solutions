from collections import Counter
class Solution(object):
    def frequencySort(self, s):
        """
        :type s: str
        :rtype: str
        """
        freq=Counter(s)
        s=sorted(freq.items(),key=lambda x:x[1],reverse=True)
        r=[]
        for k,v in s:
            a=k*v
            r.extend(a)
        return "".join(r)
