class Solution(object):
    def relativeSortArray(self, arr1, arr2):
        """
        :type arr1: List[int]
        :type arr2: List[int]
        :rtype: List[int]
        """
        
        r1=[]
        r2=[]
        for i in arr2:
            if i in arr1:
                c=arr1.count(i) 
                for k in range(c):
                    r1.append(i)
        for i in arr1:
            if i not in r1:
                r2.append(i)
                r2.sort()
        return r1+r2
