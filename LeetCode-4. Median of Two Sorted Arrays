class Solution:
    def findMedianSortedArrays(self, nums1: List[int], nums2: List[int]) -> float:
        nums1=nums1+nums2

        nums1.sort()

        n=len(nums1)
        l=0
        u=n-1
        if (n%2!=0):
   
            r=(l+u)//2
            a=nums1[r]
            return a
        else:
            r=(l+u)//2
            
            r1=(nums1[r]+nums1[r+1])
            return(r1/2)
